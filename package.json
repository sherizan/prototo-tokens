{
  "name": "@sherizan/prototo-tokens",
  "version": "0.5.0",
  "description": "Prototo design tokens. Platform-neutral, unitless, and shared across the site, the desktop app and the iOS viewer.",
  "license": "MIT",
  "author": "Sherizan Sheikh",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherizan/prototo-tokens.git"
  },
  "homepage": "https://github.com/sherizan/prototo-tokens#readme",
  "keywords": [
    "design-tokens",
    "design-system",
    "prototo"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./src": "./src/index.ts",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "src",
    "tokens.json",
    "DESIGN.md",
    "SKILL.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tokens:json": "npm run build && node scripts/build-json.mjs",
    "check": "npm run tokens:json && git diff --exit-code tokens.json",
    "prepublishOnly": "npm run tokens:json && node scripts/build-css.mjs",
    "prepare": "npm run build",
    "tokens:css": "npm run build && node scripts/build-css.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
